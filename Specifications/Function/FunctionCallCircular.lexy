function Function1
  parameters
    number Value
  results
    number Result
  ... = Function2(...)

function Function2
  parameters
    number Value
  results
    number Result
  ... = Function1(...)

scenario CallCircularFunction
  function Function1
  expectErrors
    "Circular reference detected in 'Function1': 'Function2'"
    "Circular reference detected in 'Function2': 'Function1'"

function SingleTypeArgumentWithOwnParametersTypeFunction
  parameters
    SingleTypeArgumentWithOwnParametersTypeFunction.Parameters Values

scenario SingleTypeArgumentWithOwnParametersType
  function SingleTypeArgumentWithOwnParametersTypeFunction
  expectErrors
    "Circular reference detected in 'SingleTypeArgumentWithOwnParametersTypeFunction': 'SingleTypeArgumentWithOwnParametersTypeFunction'"

function SingleTypeArgumentWithOwnResultsTypeFunction
  results
    SingleTypeArgumentWithOwnResultsTypeFunction.Results Result

scenario SingleTypeArgumentWithOwnResultsType
  function SingleTypeArgumentWithOwnResultsTypeFunction
  expectErrors
    "Circular reference detected in 'SingleTypeArgumentWithOwnResultsTypeFunction': 'SingleTypeArgumentWithOwnResultsTypeFunction'"
